#.-----------------------------------------------------------------------------
#| file-desc   : wincompose key-config file
#| file-name   : 03_left.xcompose
#| set-name    : Math double-struck
#| set-sample  : ℕ ℤ ℚ ℝ ℍ 𝕡 𝕢 𝕨 𝕩 𝕫 𝟝 𝟘
#| set-notes   : Latin double-struck
#| set-trigger : ← LEFT ARROW
#'-----------------------------------------------------------------------------

<Multi_key> <Left> <Left>       : "←"
<Multi_key> <Left> <Up>         : "↖"

<Multi_key> <Left> <asterisk>   : "·"       # middle dot
# <Multi_key> <Left> <period>     : "°"       # degree (Celsius)

<Multi_key> <Left> <0> : "𝟘"
<Multi_key> <Left> <1> : "𝟙"
