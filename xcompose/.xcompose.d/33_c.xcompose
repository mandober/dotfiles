#|-----------------------------------------------------------------------------
#| origin     : wincompose key config
#| file-name  : 33_c.xcompose
#| leaders    : <c> and <C>
#| desc       : Cursive Latin Alphabets
#| variants   : {normal,bold} {lowercase,uppercase}
#|   cursive normal lower:  𝒶𝒷𝒸𝒹ℯ𝒻ℊ𝒽𝒾𝒿𝓀𝓁𝓂𝓃ℴ𝓅𝓆𝓇𝓈𝓉𝓊𝓌𝓍𝓎𝓏
#|   cursive normal upper:  𝒜ℬ𝒞𝒟ℰℱ𝒢ℋℐ𝒥𝒦ℒℳ𝒩𝒪𝒫𝒬ℛ𝒮𝒯𝒰𝒲𝒳𝒴𝒵
#|   cursive bold   lower:  𝓪𝓫𝓬𝓭𝓮𝓯𝓰𝓱𝓲𝓳𝓴𝓵𝓶𝓷𝓸𝓹𝓺𝓻𝓼𝓽𝓾𝓿𝔀𝔁𝔂𝔃
#|   cursive bold   upper:  𝓐𝓑𝓒𝓓𝓔𝓕𝓖𝓗𝓘𝓙𝓚𝓛𝓜𝓝𝓞𝓟𝓠𝓡𝓢𝓣𝓤𝓥𝓦𝓧𝓨𝓩
#|---------------------------------------------------------------------

#| 𝒶𝒷𝒸𝒹ℯ𝒻ℊ𝒽𝒾𝒿𝓀𝓁𝓂𝓃ℴ𝓅𝓆𝓇𝓈𝓉𝓊𝓌𝓍𝓎𝓏
#| SCRIPT SMALL: e g o
#| MATHEMATICAL SCRIPT SMALL: {a-z} \ {e g o}
